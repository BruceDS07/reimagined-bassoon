<!DOCTYPE html>
<html lang="en">
<head>
  <meta http-equiv="Content-Type" content="text/html;charset=UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>𝗗𝗼𝘄𝗻𝗹𝗼𝗮𝗱 𝗱𝗲 𝗩𝗶𝗱𝗲𝗼𝘀 𝗱𝗼 𝗬𝗼𝘂𝘁𝘂𝗯𝗲</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
  <style>
    body {
      background-color: #6D6C80;
    }

    input {
      margin: 5px;
      margin-bottom: 20px;
      background-color: #6D6C80 !important;
    }

    input::placeholder {
      color: black !important;
      opacity: 1;
    }
  </style>
<head>
<body>
  <div class="container my-5">
    <h1 class="text-center">𝗗𝗼𝘄𝗻𝗹𝗼𝗮𝗱 𝗱𝗲 𝗩𝗶𝗱𝗲𝗼𝘀 𝗱𝗼 𝗬𝗼𝘂𝘁𝘂𝗯𝗲</h1>
    <form method="GET" action="/download" class="my-5">
      <div class="form-group ">
        <label for="exampleInputEmail1" class="text-center">𝙳𝚎𝚜𝚎𝚗𝚟𝚘𝚕𝚟𝚒𝚍𝚘 𝚙𝚘𝚛 𝔽𝕒𝕟𝕒𝕣𝕣𝕠𝕨</label>
        <input type="text" name="url" class="form-control text-center" placeholder="𝗖𝗼𝗹𝗼𝗾𝘂𝗲 𝗮 𝗨𝗥𝗟 𝗱𝗼 𝗩𝗶𝗱𝗲𝗼 𝗲 𝗰𝗹𝗶𝗾𝘂𝗲 𝗲𝗺 𝗕𝗮𝗶𝘅𝗮𝗿">
      </div>
      <div class="text-center">
        <button type="submit" class="btn btn-primary">𝗕𝗮𝗶𝘅𝗮𝗿</button>
      </div>
    </form>
  </div>
</body>
</html>
